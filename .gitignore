__pycache__/
*.py[cod]
.venv/
.pytest_cache/
out/
.DS_Store

# Source video runs to gigabytes and stays out of the repository. CSV and VBO are small
# enough to keep, and double as fixtures.
*.MP4
*.LRV
*.THM
# Everybody's own track days stay out, whatever a camera or a logger chose to call the
# file. One sample project is committed, because its telemetry is small and the tests and
# CI build a real session from it.
data/*
!data/slovakia-ring-2026-09-12/
data/slovakia-ring-2026-09-12/*
!data/slovakia-ring-2026-09-12/*.csv
!data/slovakia-ring-2026-09-12/*.vbo
data_bak/

# Browser automation artifacts
.playwright-cli/

# Review archives: half a megabyte of agent transcripts per round. The calibration beside
# them is committed, since that is what makes a review mean anything here.
.revmux/tasks/
