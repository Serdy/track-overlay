__pycache__/
*.py[cod]
.venv/
.pytest_cache/
out/
.DS_Store

# Source video runs to gigabytes and stays out of the repository. CSV and VBO are small
# enough to keep, and double as fixtures.
*.MP4
*.LRV
*.THM
# Everybody's own track days stay out; one sample project is committed, because the
# telemetry is small and the tests and CI build a real session from it.
data/*/*.csv
data/*/*.vbo
!data/slovakia-ring-2026-09-12/*.csv
!data/slovakia-ring-2026-09-12/*.vbo

# A project's own state: absolute paths to footage on this machine, plus a session that
# is rebuilt from the sources in seconds.
data/*/out/
data/*/project.json
data/*/session.json
data/*/layout.json
data_bak/

# Browser automation artifacts
.playwright-cli/

# Review archives: half a megabyte of agent transcripts per round. The calibration beside
# them is committed, since that is what makes a review mean anything here.
.revmux/tasks/
